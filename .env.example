# Veřejná adresa webu bez lomítka na konci (používá se v sitemapě, canonical URL a e-mailech)
NEXT_PUBLIC_SITE_URL=https://mathex.cz

# Databáze (v docker-compose se nastaví automaticky)
POSTGRES_USER=mathex
POSTGRES_PASSWORD=zmen-me-na-dlouhe-heslo
POSTGRES_DB=mathex
DATABASE_URI=postgres://mathex:zmen-me-na-dlouhe-heslo@localhost:5432/mathex

# Tajný klíč pro Payload CMS – vygeneruj: openssl rand -hex 32
PAYLOAD_SECRET=

# Odchozí e-maily (potvrzení rezervací, notifikace poptávek).
# Bez SMTP_HOST se e-maily jen vypisují do logu.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=web@mathex.cz
SMTP_FROM_NAME=Mathex

# Volitelné: tajná iCal adresa tvého Google kalendáře.
# Obsazené termíny z kalendáře se pak v rezervacích nenabízí.
# Google Kalendář → Nastavení kalendáře → Tajná adresa ve formátu iCal
BUSY_CALENDAR_ICS_URL=

# Token pro odběr rezervací do kalendáře: https://mathex.cz/kalendar.ics?token=...
# vygeneruj: openssl rand -hex 24
CALENDAR_FEED_TOKEN=

# Volitelné: Cloudflare Turnstile (antispam bez CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Volitelné: analytika bez cookies (stačí vyplnit jednu)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
