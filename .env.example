# ===== Povinné =====

# Veřejná adresa webu bez lomítka na konci (sitemap, canonical URL, odkazy v e-mailech).
# Dokud nemáš doménu, nech třeba http://raspberrypi.local:3000
SITE_URL=https://mathex.cz

# Heslo do databáze – vygeneruj: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=mathex
POSTGRES_DB=mathex

# Tajný klíč administrace – vygeneruj: openssl rand -hex 32
PAYLOAD_SECRET=

# ===== Zveřejnění webu z domácí sítě =====

# 0.0.0.0 = web je dostupný z ostatních zařízení v domácí síti (http://<ip-pi>:3000).
# Prázdné = jen z Pi samotného (stačí, když používáš Cloudflare Tunnel).
WEB_BIND=

# Cloudflare Tunnel – token z Cloudflare Zero Trust → Networks → Tunnels (viz README)
CLOUDFLARE_TUNNEL_TOKEN=

# ===== E-maily (potvrzení rezervací, upozornění na poptávky) =====
# Bez SMTP_HOST se e-maily jen vypisují do logu: docker compose logs web
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=web@mathex.cz
SMTP_FROM_NAME=Mathex

# ===== Kalendář v iPhonu (iCloud přes CalDAV) =====
# Volné termíny se počítají podle tvého kalendáře a rezervace se do něj rovnou zapisují.
# Heslo pro aplikace: appleid.apple.com → Přihlášení a zabezpečení → Hesla pro aplikace.
# Které kalendáře blokují a kam se zapisuje, nastavíš v administraci → Nastavení rezervací.
CALDAV_USERNAME=
CALDAV_PASSWORD=
# CALDAV_URL=https://caldav.icloud.com

# Volitelně: další kalendář podle adresy iCal (lze přidat i v administraci)
BUSY_CALENDAR_ICS_URL=

# Odběr rezervací do kalendáře: https://tvuj-web/kalendar.ics?token=...
# vygeneruj: openssl rand -hex 24
CALENDAR_FEED_TOKEN=

# ===== Volitelné =====

# Cloudflare Turnstile (antispam bez CAPTCHA)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytika bez cookies – vyplň jednu z nich
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=https://plausible.io/js/script.js
UMAMI_WEBSITE_ID=
UMAMI_SRC=

# Výchozí obsah se nahraje sám při prvním startu s prázdnou databází. Vypnutí:
# SEED_ON_EMPTY=false

# Jiný obraz než ten z GitHubu (např. fork)
# WEB_IMAGE=ghcr.io/mathexresources/mathex.cz-v2:latest
