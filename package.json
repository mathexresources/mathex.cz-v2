{
  "name": "mathex-web",
  "version": "1.0.0",
  "private": true,
  "description": "Prezentační web s blogem, portfoliem a rezervací konzultací (Next.js + Payload CMS)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "payload generate:importmap && payload generate:types",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "payload run src/seed/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/email-nodemailer": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-seo": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "graphql": "^16.9.0",
    "next": "16.4.3",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.2.1",
    "payload": "3.92.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.0",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.12.4",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
